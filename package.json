{
  "private": true,
  "name": "user-service",
  "version": "1.0.0",
  "description": "User service",
  "type": "module",
  "scripts": {
    "add:model": "generate-scaffold",
    "migrate": "drizzle-kit generate",
    "unmigrate": "drizzle-kit drop",
    "build:interface": "generate-service-interface -f next -s src/models",
    "pack:interface": "npm run build:interface && npm pack ./dist",
    "prebuild": "ts-unused-exports tsconfig.json --excludePathsFromReport='app;.config;instrumentation;schema;models'",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@omer-x/next-openapi-json-generator": "^2.0.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "drizzle-zod": "^0.8.3",
    "next": "^15.5.6",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "swagger-ui-react": "^5.29.5"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.6",
    "@omer-x/eslint-config": "^2.2.6",
    "@omer-x/next-openapi-interface-generator": "^0.11.0",
    "@omer-x/next-openapi-scaffold-generator": "^0.3.0",
    "@omer-x/openapi-types": "^1.2.2",
    "@types/node": "24.8.1",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.2",
    "@types/swagger-ui-react": "^5.18.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.38.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "ts-unused-exports": "^11.0.1",
    "typescript": "5.9.3"
  }
}
